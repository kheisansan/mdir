<Window x:Class="MdirWin.Dialogs.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        SizeToContent="WidthAndHeight" ResizeMode="NoResize">
    <Border x:Name="ToastBorder" CornerRadius="8" Background="#EE202830" Padding="16,12" MaxWidth="420">
        <StackPanel>
            <TextBlock x:Name="TitleText" Foreground="White" FontWeight="Bold" FontSize="14"/>
            <TextBlock x:Name="BodyText" Foreground="#DDEEFF" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>
    </Border>
</Window>
