<Window x:Class="MdirWin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MdirWin.Controls"
        Title="Mdir for Windows" Width="1400" Height="850"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" MinWidth="180"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="220" MinWidth="160"/>
            </Grid.ColumnDefinitions>

            <!-- 左サイドバー -->
            <Grid Grid.Column="0" Background="#F4F6F8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 1. フォルダツリー（左ペイン用） -->
                <DockPanel Grid.Row="0">
                    <TextBlock DockPanel.Dock="Top" Text="フォルダツリー（左ペイン）" FontWeight="Bold" Margin="8,8,8,4"/>
                    <controls:FolderTreeControl x:Name="LeftTree" Margin="4,0,4,4"/>
                </DockPanel>

                <!-- 2. コピー元フォルダ -->
                <GroupBox Grid.Row="1" Header="コピー元のフォルダ" Margin="8,4">
                    <DockPanel Margin="4">
                        <Button x:Name="BrowseSourceButton" DockPanel.Dock="Right" Content="Browse..." Width="70"
                                Margin="6,0,0,0" Focusable="False" Click="BrowseSource_Click"/>
                        <TextBox x:Name="SourceFolderBox" VerticalContentAlignment="Center" IsReadOnly="True"
                                 Focusable="False" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                    </DockPanel>
                </GroupBox>

                <!-- 3. コピー先フォルダ -->
                <GroupBox Grid.Row="2" Header="コピー先のフォルダ" Margin="8,4,8,8">
                    <StackPanel Margin="4">
                        <DockPanel>
                            <Button x:Name="BrowseDestButton" DockPanel.Dock="Right" Content="Browse..." Width="70"
                                    Margin="6,0,0,0" Focusable="False" Click="BrowseDest_Click"/>
                            <TextBox x:Name="DestFolderBox" VerticalContentAlignment="Center" IsReadOnly="True"
                                     Focusable="False" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                        </DockPanel>
                        <TextBlock Margin="0,8,0,0" Foreground="Gray" FontSize="11" TextWrapping="Wrap"
                                   Text="Win+Ctrl+Shift+[ : コピー元 → コピー先へ強制上書きコピー&#10;Win+Ctrl+Shift+] : コピー先 → コピー元へ強制上書きコピー"/>
                    </StackPanel>
                </GroupBox>
            </Grid>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="#D0D0D0"/>

            <!-- 2ペインファイラー -->
            <Grid Grid.Column="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="4"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <controls:FilePaneControl x:Name="LeftPane" Grid.Column="0" Margin="2"/>
                <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="#D0D0D0"/>
                <controls:FilePaneControl x:Name="RightPane" Grid.Column="2" Margin="2"/>
            </Grid>

            <GridSplitter Grid.Column="3" HorizontalAlignment="Stretch" Background="#D0D0D0"/>

            <!-- 右サイドバー（右ペイン用ツリー） -->
            <DockPanel Grid.Column="4" Background="#F4F6F8">
                <TextBlock DockPanel.Dock="Top" Text="フォルダツリー（右ペイン）" FontWeight="Bold" Margin="8,8,8,4"/>
                <controls:FolderTreeControl x:Name="RightTree" Margin="4,0,4,4"/>
            </DockPanel>
        </Grid>

        <!-- 下部ステータスバー / コマンドライン -->
        <Border Grid.Row="1" Background="#16212B" MinHeight="26">
            <Grid>
                <DockPanel x:Name="StatusBarPanel" Margin="10,4">
                    <TextBlock x:Name="StatusBranchText" DockPanel.Dock="Right" Foreground="#7EE2A8"
                               FontWeight="Bold" FontSize="12" Margin="12,0,0,0"/>
                    <TextBlock DockPanel.Dock="Right" Foreground="#7A8A99" FontSize="11" Margin="12,1,0,0"
                               Text="h/j/k/l 移動  Space マーク  c/m コピー/移動  d 削除  Tab ペイン切替  : コマンド"/>
                    <TextBlock x:Name="StatusPathText" Foreground="#E8EEF4" FontSize="12" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
                <TextBox x:Name="CommandBox" Visibility="Collapsed"
                         Background="#16212B" Foreground="#E8EEF4" CaretBrush="#E8EEF4"
                         BorderThickness="0" FontFamily="Consolas" FontSize="13"
                         VerticalContentAlignment="Center" Padding="8,2"
                         PreviewKeyDown="CommandBox_PreviewKeyDown"/>
            </Grid>
        </Border>
    </Grid>
</Window>
